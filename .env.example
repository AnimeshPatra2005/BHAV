# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# 3.6 Flash, not 3.8: 3.8 was 503-ing under load and its heavier default
# reasoning adds latency a classification task does not need.
BHAV_MODEL=gemini-3.6-flash

# Comma-separated fallback chain for the vision call. One model by default.
BHAV_MODEL_CHAIN=gemini-3.6-flash

# Set to 1 to let vision errors raise with a full traceback instead of being
# caught and reported to the agent.
BHAV_DEBUG=
